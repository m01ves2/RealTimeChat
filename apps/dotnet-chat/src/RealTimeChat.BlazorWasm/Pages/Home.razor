@page "/"
@using System.Net
@using System.Net.Http.Json
@using RealTimeChat.Contracts.Authentication
@using RealTimeChat.Contracts.Rooms

@inject HttpClient Http

<PageTitle>Real-Time Chat</PageTitle>

<main class="chat-page lobby-page">
    <h1>Real-Time Chat</h1>

    @if (_isLoading) {
        <p>Checking your session...</p>
    }
    else if (_user is null) {
        <section>
            <h2>Sign in</h2>

            <form class="login-form" @onsubmit="LoginAsync" @onsubmit:preventDefault>
                <label for="username">Username</label>
                <input id="username" @bind="_userName" @bind:event="oninput" />

                <label for="password">Password</label>
                <input id="password" type="password"
                       @bind="_password" @bind:event="oninput" />

                <button type="submit">Sign in</button>
            </form>

            @if (_loginError is not null) {
                <p role="alert">@_loginError</p>
            }
        </section>
    }
    else {
        <header class="lobby-header">
            <p>Signed in as <strong>@_user.UserName</strong></p>
            <button type="button" @onclick="LogoutAsync">Sign out</button>
        </header>

        <section>
            <h2>Rooms</h2>

            @if (_rooms.Length == 0) {
                <p>No rooms available.</p>
            }
            else {
                <ul class="room-list">
                    @foreach (var room in _rooms) {
                        <li>
                            <a href="@($"/rooms/{room.Id}")">@room.Name</a>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</main>

@code {
    private CurrentUserResponse? _user;
    private bool _isLoading = true;
    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string? _loginError;

    private RoomResponse[] _rooms = [];

    private async Task LoadRoomsAsync()
    {
        _rooms = await Http.GetFromJsonAsync<RoomResponse[]>("api/rooms/") ?? [];
    }

    private async Task LoginAsync()
    {
        _loginError = null;

        using var response = await Http.PostAsJsonAsync("api/auth/login", new LoginRequest(_userName, _password));

        _password = string.Empty;

        if (response.StatusCode == HttpStatusCode.Unauthorized) {
            _loginError = "Wrong username or password.";
            return;
        }

        response.EnsureSuccessStatusCode();
        _user = await response.Content.ReadFromJsonAsync<CurrentUserResponse>();

        await LoadRoomsAsync();
    }

    private async Task LogoutAsync()
    {
        using var response = await Http.PostAsync("api/auth/logout", null);
        response.EnsureSuccessStatusCode();

        _user = null;

        _rooms = [];
    }


    protected override async Task OnInitializedAsync()
    {
        try {
            using var response = await Http.GetAsync("api/auth/me");

            if (response.StatusCode == HttpStatusCode.Unauthorized) {
                return;
            }

            response.EnsureSuccessStatusCode();
            _user = await response.Content.ReadFromJsonAsync<CurrentUserResponse>();

            await LoadRoomsAsync();
        }
        finally {
            _isLoading = false;
        }
    }
}