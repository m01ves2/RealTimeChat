@page "/rooms/{RoomId:int}"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@using RealTimeChat.Contracts.Messages
@using RealTimeChat.Contracts.Rooms
@using RealTimeChat.Contracts.Users
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@inject HttpClient Http

<PageTitle>@(_room?.Name ?? "Room")</PageTitle>

<main class="chat-page room-page">
    <header class="room-header">
        <a class="back-to-rooms" href="/">← Rooms</a>
        <span role="status">@_connectionStatus</span>
    </header>

    @if (_room is null) {
        <p>Loading room...</p>
    }
    else {
        <h1>@_room.Name</h1>

        <div class="room-layout">
            <section class="room-conversation">
                <h2 id="messages-title">Messages</h2>

                <div class="message-scroll" @ref="_messageScroll">
                    @if (_messages.Length == 0) {
                        <p>No messages yet.</p>
                    }
                    else {
                        <ul class="message-list">
                            @foreach (var message in _messages) {
                                <li class="@(message.RecipientId is null ? "message" : "message message-private")">
                                    <div class="message-meta">
                                        <strong>
                                            <button type="button" class="recipient-link"
                                                    @onclick="() => SelectRecipient(message.AuthorId, message.AuthorName)">
                                                @message.AuthorName
                                            </button>
                                        </strong>

                                        @if (message.RecipientName is not null) {
                                            <span class="private-recipient">→ @message.RecipientName · Private</span>
                                        }

                                        <time datetime="@message.CreatedAt.ToString("O")">
                                            @message.CreatedAt.ToLocalTime().ToString("HH:mm")
                                        </time>
                                    </div>

                                    <p class="message-text">@message.Text</p>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>

            <aside class="room-users">
                <h2>Online users</h2>
                <ul>
                    @foreach (var user in _onlineUsers) {
                        <li>
                            <button type="button" class="recipient-link"
                                    @onclick="() => SelectRecipient(user.UserId, user.UserName)">
                                @user.UserName
                            </button>
                        </li>
                    }
                </ul>
            </aside>
        </div>

        @if (_typingUserName is not null) {
            <p role="status">@_typingUserName is typing...</p>
        }

        <form class="room-composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
            <label for="recipient-name">To</label>
            <div class="recipient-row">
                <input id="recipient-name"
                       value="@(_recipientName ?? "Everyone")"
                       readonly />

                @if (_recipientId is not null) {
                    <button type="button" class="recipient-reset"
                            @onclick="SendToEveryone">
                        Everyone
                    </button>
                }
            </div>

            <label for="message-text">Message</label>
            <textarea id="message-text" rows="3" maxlength="500" @bind="_draft" @bind:event="oninput" @bind:after="NotifyTypingAsync"></textarea>

            <button type="submit" disabled="@(_hubConnection?.State != HubConnectionState.Connected || string.IsNullOrWhiteSpace(_draft))">
                Send
            </button>

            @if (_sendError is not null) {
                <p role="alert">@_sendError</p>
            }
        </form>
    }
</main>

@code {
    [Parameter]
    public int RoomId { get; set; }

    private ChatMessageResponse[] _messages = [];

    private RoomResponse? _room;

    private HubConnection? _hubConnection;
    private string _connectionStatus = "Connecting...";
    private string _draft = "";

    private int? _recipientId;
    private string? _recipientName;
    private string? _sendError;

    private OnlineUserResponse[] _onlineUsers = [];
    private DateTimeOffset _lastTypingNotificationAt = DateTimeOffset.MinValue;

    private string? _typingUserName;
    private int _typingSequence;

    // message scrolling
    private ElementReference _messageScroll;
    private bool _scrollToLatest;


    protected override async Task OnParametersSetAsync()
    {
        SendToEveryone();

        _room = await Http.GetFromJsonAsync<RoomResponse>($"api/rooms/{RoomId}");
        _messages = await Http.GetFromJsonAsync<ChatMessageResponse[]>($"api/rooms/{RoomId}/messages") ?? [];
        _scrollToLatest = true;

        _typingSequence++;
        _typingUserName = null;

        try {
            await EnsureConnectedAsync();
            await _hubConnection!.InvokeAsync("JoinRoom", RoomId);
            _connectionStatus = "Connected to the room";
        }
        catch (Exception ex) {
            _connectionStatus = $"Connection error: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToLatest || _room is null)
            return;

        _scrollToLatest = false;
        await JS.InvokeVoidAsync("scrollChatToBottom", _messageScroll);
    }

    private async Task EnsureConnectedAsync()
    {
        if (_hubConnection is null) {
            var connection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("chat"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection = connection;
            RegisterHubHandlers(connection);
        }

        if (_hubConnection.State == HubConnectionState.Disconnected) {
            await _hubConnection.StartAsync();
        }
    }

    private void RegisterHubHandlers(HubConnection connection)
    {
        // handler for received message from Hub
        connection.On<ChatMessageResponse>("ReceiveMessage", HandleReceivedMessageAsync);

        // handler for user list changed
        connection.On<int, OnlineUserResponse[]>("OnlineUsersChanged", HandleOnlineUsersChangedAsync);

        // Handler for lost connection. Trying to reconnect
        connection.Reconnecting += _ => SetConnectionStatusAsync("Reconnecting...");

        // Handler for reconnected state - Join Room and Get recent messages
        connection.Reconnected += _ => RestoreRoomAfterReconnectAsync(connection);

        // Handler for closed connection
        connection.Closed += _ => SetConnectionStatusAsync("Disconnected");

        // Handle text typing
        connection.On<int, int, string>("UserTyping", HandleUserTypingAsync);
    }

    private async Task HandleReceivedMessageAsync(ChatMessageResponse message)
    {
        await InvokeAsync(async () =>
        {
            if (message.RoomId != RoomId || _messages.Any(m => m.Id == message.Id))
                return;

            var wasAtBottom = await JS.InvokeAsync<bool>("isChatAtBottom", _messageScroll);

            if (message.RoomId != RoomId || _messages.Any(m => m.Id == message.Id)) //second check bec a new message could be added while JS invoking
                return;

            // _messages = [.. _messages, message]; Теперь отправитель тоже получает своё сообщение через подписку.
            _scrollToLatest = wasAtBottom;
            StateHasChanged();
        });
    }

    private async Task HandleOnlineUsersChangedAsync(int roomId, OnlineUserResponse[] users)
    {
        await InvokeAsync(() =>
        {
            if (roomId != RoomId)
                return;

            _onlineUsers = users;
            StateHasChanged();
        });
    }

    private Task SetConnectionStatusAsync(string status)
    {
        return InvokeAsync(() =>
        {
            _connectionStatus = status;
            StateHasChanged();
        });
    }

    private async Task RestoreRoomAfterReconnectAsync(HubConnection connection)
    {
        var roomId = RoomId;

        try {
            await connection.InvokeAsync("JoinRoom", roomId);

            var recentMessages =
                await Http.GetFromJsonAsync<ChatMessageResponse[]>($"api/rooms/{roomId}/messages") ?? [];

            var wasAtBottom = await JS.InvokeAsync<bool>("isChatAtBottom", _messageScroll);

            await InvokeAsync(() =>
            {
                if (RoomId != roomId)
                    return;

                _messages = _messages
                    .Concat(recentMessages)
                    .DistinctBy(message => message.Id)
                    .OrderBy(message => message.CreatedAt)
                    .ThenBy(message => message.Id)
                    .ToArray();
                _scrollToLatest = wasAtBottom;

                _connectionStatus = "Connected to the room";
                StateHasChanged();
            });
        }
        catch (Exception ex) {
            await InvokeAsync(() =>
            {
                if (RoomId != roomId)
                    return;

                _connectionStatus = $"Could not rejoin room: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private async Task SendAsync()
    {
        _sendError = null;

        var text = _draft.Trim();

        if (text.Length is 0 or > 500 || _hubConnection?.State != HubConnectionState.Connected)
            return;

        try {
            await SendMessageToHubAsync(_hubConnection, text);
            _draft = "";
        }
        catch (Exception ex) {
            _sendError = ex.Message;
        }
    }

    private async Task SendMessageToHubAsync(HubConnection connection, string text)
    {
        if (_recipientId is int recipientId) {
            await connection.InvokeAsync("SendPrivateMessage", RoomId, text, recipientId);
        }
        else {
            await connection.InvokeAsync("SendMessage", RoomId, text);
        }
    }

    private async Task NotifyTypingAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft) || _hubConnection?.State != HubConnectionState.Connected)
            return;

        var now = DateTimeOffset.UtcNow;

        if (now - _lastTypingNotificationAt < TimeSpan.FromSeconds(1))
            return;

        _lastTypingNotificationAt = now;

        try {
            await _hubConnection.InvokeAsync("NotifyTyping", RoomId);
        }
        catch (Exception ex) {
            Console.Error.WriteLine($"Could not send typing status: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null) {
            await _hubConnection.DisposeAsync();
        }
    }

    private async Task HandleUserTypingAsync(int roomId, int userId, string userName)
    {
        var sequence = 0;

        await InvokeAsync(() =>
        {
            if (roomId != RoomId)
                return;

            _typingUserName = userName;
            sequence = ++_typingSequence;
            StateHasChanged();
        });

        if (sequence != 0)
            _ = HideTypingAfterDelayAsync(roomId, sequence);
    }

    private async Task HideTypingAfterDelayAsync(int roomId, int sequence)
    {
        try {
            await Task.Delay(TimeSpan.FromSeconds(3));

            await InvokeAsync(() =>
            {
                if (roomId != RoomId || sequence != _typingSequence)
                    return;

                _typingUserName = null;
                StateHasChanged();
            });
        }
        catch (Exception ex) {
            Console.Error.WriteLine($"Could not clear typing status: {ex.Message}");
        }
    }

    private void SelectRecipient(int userId, string userName)
    {
        _recipientId = userId;
        _recipientName = userName;
    }

    private void SendToEveryone()
    {
        _recipientId = null;
        _recipientName = null;
    }
}