@page "/"
@using RealTimeChat.Application.Models
@using RealTimeChat.Application.Services
@inject ChatService ChatService

<PageTitle>Real-Time Chat</PageTitle>

<h1>Real-Time Chat</h1>


@* Вход обрабатывается обычным HTTP POST:
   SignInManager выдаёт cookie через заголовок HTTP-ответа.
   В интерактивном обработчике Blazor такой возможности нет.
   
   Для Blazor Server с cookie-аутентификацией это стандартный подход: вход и выход обрабатываются обычными HTTP-запросами, 
   а сам чат работает через интерактивные серверные компоненты.*@
<AuthorizeView>
    <Authorized Context="auth">
        <p>
            Signed in as
            <strong>@auth.User.Identity?.Name</strong>
        </p>
    </Authorized>
    <NotAuthorized>
        <a href="/login">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@if (_rooms is null) {
    <p>Loading rooms...</p>
}
else {
    <ul>
        @foreach (var room in _rooms) {
            <li>@room.Name</li>
        }
    </ul>
}

@code {
    private IReadOnlyList<RoomInfo>? _rooms;

    protected override async Task OnInitializedAsync()
    {
        _rooms = await ChatService.GetRoomsAsync(CancellationToken.None);
    }
}