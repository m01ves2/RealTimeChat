@page "/rooms/{RoomId:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using RealTimeChat.Application.Exceptions
@using RealTimeChat.Application.Models
@using RealTimeChat.Application.Services
@using RealTimeChat.BlazorServer.Services

@attribute [Authorize]

@* Уход из комнаты включает асинхронное уведомление остальных участников.*@
@implements IAsyncDisposable 

@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ChatNotifier Notifier
@inject RoomPresence Presence

<a href="/">← Rooms</a>

@if (_isLoading) {
    <p>Loading room...</p>
}
else if (_room is not null) {
    <h1>@_room.Name</h1>

    <h2>Online users (@_onlineUsers.Count)</h2>

    <ul>
        @foreach (var user in _onlineUsers) {
            <li @key="user.Id">
                @user.UserName
                @if (user.Id == _userId) {
                    <span> (you)</span>
                }
            </li>
        }
    </ul>

    @if (_messages.Count == 0) {
        <p>No messages yet.</p>
    }
    else {
        <ul>
            @foreach (var message in _messages) {
                <li @key="message.Id">
                    <strong>@message.AuthorName</strong>

                    @if (message.RecipientId is not null) {
                        <span>
                            → @message.RecipientName · Private
                        </span>
                    }

                    <span>
                        @message.CreatedAt.ToString("HH:mm") UTC
                    </span>

                    <p>@message.Text</p>
                </li>
            }
        </ul>

        <form @onsubmit="SendAsync" @onsubmit:preventDefault>
            @* интерактивная форма: preventDefault отменяет обычную отправку HTML-формы, а Blazor вызывает SendAsync на сервере через соединение circuit.
            @bind:event="oninput" обновляет _text при вводе каждого символа. *@

            <label for="message">Message</label>

            <textarea id="message"
                      @bind="_text"
                      @bind:event="oninput"
                      maxlength="500"
                      disabled="@_isSending"></textarea>

            <button type="submit"
                    disabled="@(_isSending || string.IsNullOrWhiteSpace(_text))">
                @(_isSending ? "Sending..." : "Send")
            </button>
        </form>

        @if (_sendError is not null) {
            <p role="alert">@_sendError</p>
        }
    }
}

@code {
    [Parameter]
    public int RoomId { get; set; }

    private RoomInfo? _room;
    private IReadOnlyList<ChatMessageInfo> _messages = [];
    private bool _isLoading = true;
    private int _loadVersion;

    private string _text = string.Empty;
    private string? _sendError;
    private bool _isSending;

    private bool _disposed;

    private readonly Guid _participationId = Guid.NewGuid();

    private IReadOnlyList<OnlineUser> _onlineUsers = [];

    private int? _userId;
    private string? _userName;
    private bool _interactive;

    protected override void OnInitialized()
    {
        Notifier.MessageReceived += OnMessageReceivedAsync;

        Presence.UsersChanged += OnUsersChangedAsync;
    }


    protected override async Task OnParametersSetAsync()
    {
        var version = ++_loadVersion;
        var roomId = RoomId;

        _isLoading = true;
        _room = null;
        _messages = [];
        _onlineUsers = [];

        _text = string.Empty;
        _sendError = null; //При переходе в другую комнату черновик и ошибка сбросятся.
        _userId = null;
        _userName = null;

        // Если этот экземпляр компонента уже участвовал в комнате,
        // снимаем прежнее участие перед загрузкой новой.
        if (_interactive) {
            await Presence.LeaveAsync(_participationId);

            if (_disposed || version != _loadVersion)
                return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync(); // AuthenticationStateProvider даёт пользователя текущего UI-сеанса. 
                                                                                         // Из его claim берём ID для фильтрации приватной истории.

        var userIdText = authState.User
            .FindFirst(ClaimTypes.NameIdentifier)?.Value;

          
        if (authState.User.Identity?.IsAuthenticated != true
            || !int.TryParse(userIdText, out var userId)) {

            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        _userId = userId; // сохраним пользователя
        _userName = authState.User.Identity!.Name ?? userId.ToString();

        try {
            // Эти строки создают отдельную область зависимостей
            // Внутри неё DI создаёт ChatService, его репозитории и DbContext. 
            // При выходе из блока они освобождаются. Полученные RoomInfo и ChatMessageInfo остаются обычными данными, которые можно отображать.
            await using var scope = ScopeFactory.CreateAsyncScope(); // Scope — это область жизни объектов, которые создаёт DI-контейнер. 
                                                                     // Мы создаём отдельный scope ради короткой жизни зависимостей операции с БД.

            // В интерактивном Blazor Server стандартный scope живёт вместе с circuit — UI - сеансом вкладки. 
            // Клик по кнопке не создаёт новый HTTP-запрос страницы и новую область зависимостей.

            // Получить ChatService именно из этой новой области.
            var chatService = scope.ServiceProvider.GetRequiredService<ChatService>();

            var room = await chatService.GetRoomAsync(roomId, CancellationToken.None);

            var messages = await chatService.GetRecentMessagesAsync(roomId, userId, CancellationToken.None);

            //_loadVersion защищает от устаревшей загрузки: если параметры комнаты поменялись, пока мы ждали БД, старый результат не перезапишет новую страницу.
            if (version != _loadVersion) 
                return;

            _room = room;

            //_messages = messages;
            // Объединяем историю с сообщениями, пришедшими во время загрузки.
            _messages = messages.Concat(_messages)
                                .DistinctBy(message => message.Id)
                                .OrderBy(message => message.CreatedAt)
                                .ThenBy(message => message.Id)
                                .ToArray();

            _isLoading = false;

            await JoinPresenceAsync();
        }
        catch (NotFoundException) {
            if (version != _loadVersion)
                return;

            Navigation.NavigateTo("/not-found", forceLoad: true);
        }
    }

    private async Task SendAsync()
    {
        // Защита от повторной отправки, пока предыдущая ещё выполняется.
        if (_isSending || _isLoading || _room is null)
            return;

        var text = _text.Trim();

        if (text.Length == 0)
            return;

        _sendError = null;

        // Ограничение в HTML удобно для пользователя,
        // но проверка на сервере тоже нужна.
        if (text.Length > 500) {
            _sendError = "Message cannot exceed 500 characters.";
            return;
        }

        // Запоминаем комнату и версию загрузки до первого await.
        var roomId = RoomId;
        var version = _loadVersion;

        _isSending = true;

        try {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var userIdText = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (authState.User.Identity?.IsAuthenticated != true
                || !int.TryParse(userIdText, out var userId)) {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            ChatMessageInfo message;

            // Отдельный scope на всю операцию отправки.
            await using (var scope = ScopeFactory.CreateAsyncScope()) {
                var chatService = scope.ServiceProvider.GetRequiredService<ChatService>();

                await chatService.GetRoomAsync(roomId, CancellationToken.None);

                message = await chatService.SendMessageAsync(   roomId,
                                                                userId,
                                                                text,
                                                                recipientId: null,
                                                                cancellationToken: CancellationToken.None);
            }

            // Работа с БД завершена, scope уже освобождён.
            // Рассылаем сообщение даже при уходе отправителя в другую комнату.
            await Notifier.PublishPublicMessageAsync(message);

            if (version != _loadVersion)
                return;

            _text = string.Empty;
        }
        catch (ArgumentException ex) {
            if (version == _loadVersion)
                _sendError = ex.Message;
        }
        catch (NotFoundException) {
            if (version == _loadVersion)
                _sendError = "The room or user no longer exists.";
        }
        finally {
            _isSending = false;
        }
    }

    private Task OnMessageReceivedAsync(ChatMessageInfo message)
    {
        return InvokeAsync(() =>
        {
            if (_disposed || message.RoomId != RoomId)
                return;

            if (_messages.Any(existing => existing.Id == message.Id))
                return;

            _messages = _messages.Append(message)
                                .OrderBy(item => item.CreatedAt)
                                .ThenBy(item => item.Id)
                                .ToArray();

            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _interactive = true;

        await JoinPresenceAsync();
    }

    private Task JoinPresenceAsync()
    {
        if (_disposed
            || !_interactive
            || _isLoading
            || _room is null
            || _userId is null
            || _userName is null) {
            return Task.CompletedTask;
        }

        return Presence.JoinAsync(
            _participationId,
            _room.Id,
            _userId.Value,
            _userName);
    }

    private Task OnUsersChangedAsync(int roomId)
    {
        return InvokeAsync(() =>
        {
            if (_disposed || roomId != RoomId)
                return;

            // Читаем актуальный список, а не старый снимок из уведомления.
            _onlineUsers = Presence.GetUsers(roomId);

            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ++_loadVersion;

        Notifier.MessageReceived -= OnMessageReceivedAsync;
        Presence.UsersChanged -= OnUsersChangedAsync;

        await Presence.LeaveAsync(_participationId);
    }

}